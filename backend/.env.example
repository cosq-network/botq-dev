# Core
APP_NAME=botq
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
BOOTSTRAP_ENABLED=true
BOOTSTRAP_TOKEN=dev-bootstrap-token-change-me
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://botq:botq@localhost:5432/botq

# Auth
AUTH_MODE=local
LOCAL_AUTH_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_SUCCESS_REDIRECT_URI=/
TOKEN_TTL_SECONDS=86400
TOKEN_ACTIVITY_UPDATE_SECONDS=300
DEFAULT_ORG_SLUG=cdx

# Requirement analysis provider (rules for local/CI; heroku or runpod for managed inference).
# Use comma-separated order, e.g. heroku,runpod, for explicit fallback.
REQUIREMENT_ANALYSIS_PROVIDER=rules
REQUIREMENT_ANALYSIS_TIMEOUT_SECONDS=120
REQUIREMENT_ANALYSIS_PROMPT_VERSION=rules-v1
REQUIREMENT_ANALYSIS_POLICY_VERSION=baseline-v1
HEROKU_INFERENCE_BASE_URL=
HEROKU_INFERENCE_KEY=
HEROKU_INFERENCE_MODEL=
HEROKU_INFERENCE_MAX_TOKENS=4096
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_INFERENCE_URL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_MAX_TOKENS=4096

# Phase 3 implementation worker. Use heroku, runpod, or an explicit fallback
# such as heroku,runpod. disabled keeps the worker from making external calls.
AGENT_IMPLEMENTATION_PROVIDER=disabled
AGENT_IMPLEMENTATION_MODEL=
AGENT_IMPLEMENTATION_TIMEOUT_SECONDS=180
AGENT_WORKER_LEASE_SECONDS=900
AGENT_WORKER_POLL_SECONDS=30

# Penpot (optional read-only Phase 4 adapter; writes/comments use human handoff).
PENPOT_API_BASE_URL=
PENPOT_API_TOKEN=
PENPOT_FILE_PATH=/api/files/{file_id}
PENPOT_API_TIMEOUT_SECONDS=15

# Optional external non-production preview deployment adapter.
# The adapter must return {"url":"https://...", "deployment_id":"...", "evidence":{}}.
PREVIEW_DEPLOYMENT_URL=
PREVIEW_DEPLOYMENT_TOKEN=
PREVIEW_DEPLOYMENT_TIMEOUT_SECONDS=120

# Phase 5 controlled deployment webhook. It must return deployment_id, status,
# diagnostics, and health_checks. Rollback may use a separate HTTPS endpoint.
DEPLOYMENT_URL=
DEPLOYMENT_ROLLBACK_URL=
DEPLOYMENT_TOKEN=
DEPLOYMENT_TIMEOUT_SECONDS=180
# Use local_compose only for a controlled local/non-production target.
DEPLOYMENT_ADAPTER=webhook
# Multiple compose files may be comma-separated, for example:
# LOCAL_COMPOSE_FILE=docker-compose.yml,docker-compose.production.yml
LOCAL_COMPOSE_FILE=
# Required for a real local rollback: previous release Compose definition(s).
LOCAL_COMPOSE_ROLLBACK_FILE=
LOCAL_COMPOSE_PROJECT=
LOCAL_DEPLOYMENT_HEALTH_URL=
LOCAL_DEPLOYMENT_HEALTH_TIMEOUT_SECONDS=90

# Phase 6 hardening. Use RATE_LIMIT_BACKEND=redis with REDIS_URL for shared
# limits across multiple API instances. Retention execution requires confirm=true.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RETENTION_AUDIT_DAYS=365
RETENTION_AGENT_EVENT_DAYS=90
RETENTION_CHECKPOINT_DAYS=30

# Audit
AUDIT_SECRET=change-me-audit-chain-secret

# Secrets (development may derive a key; production requires a valid Fernet key)
SECRET_ENCRYPTION_KEY=

# Git
GIT_SSH=ssh
GIT_KEY_DIR=secrets/git
GIT_KNOWN_HOSTS=secrets/git/known_hosts
GIT_SSH_CONNECT_TIMEOUT=10

# Sandbox / runner
RUNTIME_RUNNER=subprocess
SANDBOX_WORKSPACE_DIR=workspaces
SANDBOX_IMAGES_ALLOWLIST=python:3.13-slim,node:22-bookworm,botq/toolchain:latest
SANDBOX_NETWORK_ALLOWLIST=none
SANDBOX_ALLOW_HOST_NETWORK=false
# Production rejects host networking even when this flag is set.
SANDBOX_ALLOW_PRIVILEGED=false
SANDBOX_ALLOW_HOST_MOUNTS=false
SANDBOX_DEFAULT_CPU=1.0
SANDBOX_DEFAULT_MEMORY=1g
SANDBOX_DEFAULT_PIDS=256
SANDBOX_DEFAULT_TIMEOUT=600
SANDBOX_MAX_CPU=4.0
SANDBOX_MAX_MEMORY_BYTES=4294967296
SANDBOX_MAX_PIDS=1024
SANDBOX_MAX_TIMEOUT=3600
